{
	"name": "einstein-matchmaker",
	"version": "0.1.0",
	"type": "module",
	"private": true,
	"engines": { "node": ">=24.0.0" },
	"scripts": {
		"start": "tsx src/app/run.ts",
		"stars": "tsx src/app/stars.ts",
		"smoke": "tsx src/app/smoke.ts",
		"fetch-data": "bash scripts/fetch-data.sh",
		"check": "npm run typecheck && npm test",
