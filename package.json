		"test": "vitest run"
	},
	"dependencies": {
		"@mozaik-ai/core": "4.2.0",
		"dotenv": "^17.4.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	}
}
